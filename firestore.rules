rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 선수 4명의 최고 점수만 저장 가능
    match /scores/{player} {
      function isPlayer() {
        return player in ['홍지', '혁이', '도순', '겸이'];
      }
      function validScore() {
        let d = request.resource.data;
        return d.keys().hasOnly(['score', 'updatedAt'])
          && d.score is int
          && d.score >= 0
          && d.score < 10000000
          && d.updatedAt == request.time;
      }

      allow read: if true;
      allow create: if isPlayer() && validScore();
      // 기존 기록보다 높을 때만 덮어쓰기 가능 (기록을 낮추거나 지울 수 없음)
      allow update: if isPlayer() && validScore()
        && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }
  }
}
